<?xml version="1.0" encoding="utf-8"?>
<!--
    Główny układ XML stołu gry w Blackjacka (activity_main.xml).
    Oparty na ConstraintLayout z tłem sukna kasynowego (bg_casino_table).
    Zawiera sekcje: Nagłówek (saldo, zakład), Sekcja Krupiera, Banner stanu gry,
    Ostrzeżenie o odpowiedzialnej grze, Sekcja Gracza, Żetony zakładów oraz Przyciski Akcji.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_casino_table"
    android:padding="12dp"
    tools:context=".MainActivity">

    <!-- TOP HEADER BAR: Tytuł gry BLACKJACK -->
    <TextView
        android:id="@+id/tvAppTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:letterSpacing="0.15"
        android:shadowColor="#80000000"
        android:shadowDx="2"
        android:shadowDy="2"
        android:shadowRadius="4"
        android:text="@string/title_blackjack"
        android:textColor="@color/casino_gold"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- BALANCE BADGE: Plakietka salda gracza -->
    <LinearLayout
        android:id="@+id/llBalanceBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_score_badge"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="6dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvAppTitle">

        <TextView
            android:id="@+id/tvBalance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/casino_gold"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="Saldo: $1000" />
    </LinearLayout>

    <!-- BET BADGE: Plakietka obecnego zakładu -->
    <LinearLayout
        android:id="@+id/llBetBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_score_badge"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="6dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvAppTitle">

        <TextView
            android:id="@+id/tvCurrentBet"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="Zakład: $50" />
    </LinearLayout>

    <!-- DEALER SECTION: Etykieta i wynik krupiera -->
    <TextView
        android:id="@+id/tvDealerHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:letterSpacing="0.1"
        android:text="@string/dealer_title"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/llBalanceBadge" />

    <TextView
        android:id="@+id/tvDealerScore"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_score_badge"
        android:paddingHorizontal="10dp"
        android:paddingVertical="2dp"
        android:textColor="@color/casino_gold"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/tvDealerHeader"
        app:layout_constraintStart_toEndOf="@id/tvDealerHeader"
        app:layout_constraintTop_toTopOf="@id/tvDealerHeader"
        tools:text="10" />

    <!-- DEALER CARDS CONTAINER: Przewijany kontener na karty krupiera -->
    <HorizontalScrollView
        android:id="@+id/hsvDealerCards"
        android:layout_width="0dp"
        android:layout_height="108dp"
        android:layout_marginTop="6dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvDealerHeader">

        <LinearLayout
            android:id="@+id/llDealerCards"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:animateLayoutChanges="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="4dp">

            <!-- Przykładowy podgląd kart w edytorze IDE -->
            <include layout="@layout/item_card" />

            <include layout="@layout/item_card_back" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- CENTER GAME STATUS BANNER: Centralny banner komunikatów gry -->
    <TextView
        android:id="@+id/tvGameStatus"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_status_banner"
        android:elevation="6dp"
        android:gravity="center"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        android:text="@string/status_welcome"
        android:textColor="@color/casino_gold"
        android:textSize="15sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/tvDisclaimer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/hsvDealerCards" />

    <!-- GAMBLING RESPONSIBILITY DISCLAIMER: Ostrzeżenie o odpowiedzialnej grze -->
    <TextView
        android:id="@+id/tvDisclaimer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:shadowColor="#80000000"
        android:shadowDx="1"
        android:shadowDy="1"
        android:shadowRadius="2"
        android:text="@string/disclaimer_gambling"
        android:textColor="@color/casino_gold"
        android:textSize="12sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/tvPlayerHeader"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvGameStatus" />

    <!-- PLAYER SECTION: Etykieta i wynik gracza -->
    <TextView
        android:id="@+id/tvPlayerHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:letterSpacing="0.1"
        android:text="@string/player_title"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/hsvPlayerCards"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tvPlayerScore"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_score_badge"
        android:paddingHorizontal="10dp"
        android:paddingVertical="2dp"
        android:textColor="@color/casino_gold"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/tvPlayerHeader"
        app:layout_constraintStart_toEndOf="@id/tvPlayerHeader"
        app:layout_constraintTop_toTopOf="@id/tvPlayerHeader"
        tools:text="20" />

    <!-- PLAYER CARDS CONTAINER: Przewijany kontener na karty gracza -->
    <HorizontalScrollView
        android:id="@+id/hsvPlayerCards"
        android:layout_width="0dp"
        android:layout_height="108dp"
        android:layout_marginBottom="12dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none"
        app:layout_constraintBottom_toTopOf="@+id/llChipsContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:id="@+id/llPlayerCards"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:animateLayoutChanges="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="4dp">

            <!-- Przykładowy podgląd kart w edytorze IDE -->
            <include layout="@layout/item_card" />

            <include layout="@layout/item_card_red" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- CHIPS / BETTING ROW: Pasek wyboru żetonów i czyszczenia zakładu -->
    <LinearLayout
        android:id="@+id/llChipsContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toTopOf="@+id/llActionButtons"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/btnChip10"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_chip_10"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/chip_10"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnChip25"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_chip_25"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/chip_25"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnChip100"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_chip_100"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/chip_100"
            android:textColor="@color/casino_gold"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnChip500"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_chip_500"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/chip_500"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnClearBet"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:text="@string/btn_clear_bet"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            app:strokeColor="@color/text_secondary"
            app:strokeWidth="1dp" />
    </LinearLayout>

    <!-- ACTION BUTTONS ROW: Dolny pasek przycisków akcji (Rozdaj, Dobierz, Pasuj, Podwój) -->
    <LinearLayout
        android:id="@+id/llActionButtons"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDeal"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="@string/btn_deal"
            android:textColor="@color/black"
            android:textSize="13sp"
            android:textStyle="bold"
            app:backgroundTint="@color/casino_gold"
            app:cornerRadius="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnHit"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="@string/btn_hit"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:textStyle="bold"
            app:backgroundTint="@color/casino_green_btn"
            app:cornerRadius="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStand"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="@string/btn_stand"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:textStyle="bold"
            app:backgroundTint="@color/casino_orange_btn"
            app:cornerRadius="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDouble"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="@string/btn_double"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:textStyle="bold"
            app:backgroundTint="@color/casino_blue"
            app:cornerRadius="8dp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>